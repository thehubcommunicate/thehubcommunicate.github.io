{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about a user of The Hub.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "description": "Designer, Coder, etc." },
        "hubCoins": { "type": "number", "description": "Loyalty points." },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName"]
    },
    "Booking": {
      "title": "Booking Request",
      "description": "A room booking at The Hub.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "roomId": { "type": "string" },
        "roomName": { "type": "string" },
        "people": { "type": "string" },
        "layout": { "type": "string", "enum": ["Chữ U", "Rạp hát", "Tiệc đứng", "Lớp học"] },
        "vibe": { "type": "string" },
        "decor": { "type": "string" },
        "privacy": { "type": "string", "enum": ["public", "private"] },
        "addOns": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid"] },
        "qrPass": { "type": "string", "description": "QR Code data for check-in." },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "time", "roomId"]
    },
    "Post": {
      "title": "Community Post",
      "description": "A social media post in The Hub feed.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "content": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "likes": { "type": "number" },
        "commentCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "content", "createdAt"]
    },
    "Comment": {
      "title": "Post Comment",
      "description": "A comment on a post.",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "authorId", "content", "createdAt"]
    },
    "ServiceOrder": {
      "title": "Service Order",
      "description": "An order for a service package.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "active", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "serviceId", "serviceName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles."
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Stores room bookings."
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Stores social feed posts."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Stores comments on a specific post."
    },
    "/serviceOrders/{orderId}": {
      "schema": "ServiceOrder",
      "description": "Stores service package orders."
    }
  }
}
